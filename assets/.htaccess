# Long-lived caching for versioned JS/CSS (IPG-211). Every assets/*.js and
# assets/*.css URL is requested as ?v=<APP_VERSION>, so a release that bumps
# VERSION always gets a fresh URL; the browser can cache the old one forever.
# Unversioned files under assets/ (images, the sample log) are untouched.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
