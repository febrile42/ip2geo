# DB credentials - copy config.sample.php to config.php and fill in values
config*.php

# Written by the monthly MaxMind update script; not tracked in git
db_version.php

# MaxMind .mmdb files (scripts/fetch-mmdb.sh); license forbids redistribution
data/geoip/

# Google Search Console verification — place manually on server if needed
google*.html

# Composer — vendor dir not committed; composer.json is. vendor/.htaccess is,
# so the deploy's git reset puts the web-access deny in place (IPG-10 F1).
/vendor/*
!/vendor/.htaccess

# Node / Jest
node_modules/

# Stripe keys and environment secrets — set in config.php (already gitignored)
# Never commit these files
stripe_keys.php
.env
.env.*

# PHPUnit cache
.phpunit.result.cache

# Generated by the Spamhaus ASN-DROP diff step in update-db.yml.
# Normally only exists on the asn-classification-update-* branch,
# but gitignore it in case the step is run locally.
asn_classification_candidates.txt

# Composer lock — commit this if you want reproducible builds on CI
# composer.lock

# Claude, IDE, OS Files
.claude
